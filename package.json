    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  },
  "engines": {
    "node": ">=22"
  }
